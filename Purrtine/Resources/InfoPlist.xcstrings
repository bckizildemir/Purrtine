    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purrtine needs camera access to take photos of your cats. These photos are stored only on your device."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purrtine, kedilerinizin fotoğraflarını çekmek için kamera erişimine ihtiyaç duyar. Bu fotoğraflar yalnızca cihazınızda saklanır."
          }
        }
      }
    },
