    "about.developer_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatCareCalendar is developed by cat lovers for cat lovers. Your feedback and suggestions are very valuable to us."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatCareCalendar, kedi severler tarafından kedi severler için geliştirilmiştir. Geri bildirimleriniz ve önerileriniz bizim için çok değerli."
          }
        }
      }
    },
