    "about.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatCareCalendar is a comprehensive app that helps cat owners manage their pet care routines. With task scheduling, reminders, and detailed tracking features, it ensures your cats' health and happiness."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CatCareCalendar, kedi sahiplerinin pet bakım rutinlerini yönetmelerine yardımcı olan kapsamlı bir uygulamadır. Görev zamanlaması, hatırlatmalar ve detaylı takip özellikleri ile kedilerinizin sağlığını ve mutluluğunu garanti altına alır."
          }
        }
      }
    },
    "about.developer" : {
      "extractionState" : "manual",
      "localizations" : {
