  class s2 bugPath
  class s3 orange
  class s3 bugPath
  class s4 orange
  class s4 bugPath
  class s5 orange
  class s5 bugPath
  class s6 orange
  class s6 bugPath
  class s7 blue
  class s7 breaks
  class s7 bugPath
