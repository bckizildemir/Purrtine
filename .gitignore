# Xcode
DerivedData/
build/
*.xcworkspace
!default.xcworkspace
xcuserdata/

# Track the resolved vendor SDK versions so every checkout pins the same
# ones (see CLAUDE.md ### Dependencies). Git cannot re-include a file inside
# an excluded directory with a single "!" line, so each parent directory on
# the path has to be un-excluded too.
!CatCareCalendar.xcodeproj/project.xcworkspace/
!CatCareCalendar.xcodeproj/project.xcworkspace/xcshareddata/
!CatCareCalendar.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!CatCareCalendar.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# SwiftPM
.build/

# CocoaPods (not used, but common)
Pods/

# Carthage (not used, but common)
Carthage/

